# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gestor_eventos
POSTGRES_PORT=5432

# Mailpit Configuration
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# MinIO / Object Storage
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# Storage URLs (S3/MinIO). Doble guion bajo => sección "Storage" de la config.
#  - ServiceUrl:    endpoint interno que usa el backend para subir objetos.
#  - PublicBaseUrl: host que queda EMBEBIDO en las URLs devueltas al cliente.
#                   Debe ser alcanzable desde el navegador o el dispositivo móvil.
# Para PROBAR EN DISPOSITIVO FÍSICO, poné aquí la IP LAN de tu PC, p. ej.:
#   Storage__PublicBaseUrl=http://192.168.1.50:9000
Storage__ServiceUrl=http://localhost:9000
Storage__PublicBaseUrl=http://localhost:9000
Storage__BucketName=gestor-eventos

# Para que un dispositivo físico alcance el API, escuchá en todas las interfaces.
# Descomentá y ajustá según necesidad (por defecto el API escucha en localhost:5206):
# ASPNETCORE_URLS=http://0.0.0.0:5206
