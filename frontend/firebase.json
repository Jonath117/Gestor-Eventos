{
	"hosting": {
		"public": "dist",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [
			{
				"source": "/api/**",
				"run": {
					"serviceId": "campeando-backend",
					"region": "us-central1"
				}
			},
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	}
}
